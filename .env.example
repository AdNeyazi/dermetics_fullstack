# =============================================================================
# Next.js frontend (repo root) — copy to `.env.local` for local dev
# =============================================================================
# On Vercel/Docker/PM2: set these same keys in the host's environment UI.
#
# Public API origin as the browser sees it (no trailing slash).
# App requests `${NEXT_PUBLIC_API_URL}/api/...` with credentials (cookies).
#
# Local (Next :3000, Rails :3001):
NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Production — pick ONE pattern:
#   A) Same domain (recommended): UI and Rails both behind https://yourdomain.com
#      (e.g. / → Next, /api → Rails). Use your site URL:
# NEXT_PUBLIC_API_URL=https://yourdomain.com
#   B) Same-origin relative URLs (reverse proxy on the Next host only):
# NEXT_PUBLIC_API_URL=same-origin
#   C) API subdomain (also set COOKIE_DOMAIN on Rails, see dermetics_api/.env.example):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Must be identical to JWT_SECRET on the Rails API (dashboard middleware verifies this cookie).
# Use a long random string in production (32+ characters).
JWT_SECRET=dev-secret-change-me

# Optional: Access-Control-Allow-Origin on Next.js HTML responses (not the Rails API).
# CORS_ORIGINS=*
